# Valores públicos del proyecto Supabase. Opcionales para ejecutar el shell.
# Nunca colocar claves service_role, secretas ni credenciales privadas en VITE_.
VITE_SUPABASE_URL=
# Admite una clave publishable (sb_publishable_) o anon legacy.
VITE_SUPABASE_ANON_KEY=
# Mapas y HU17: clave PUBLICA de navegador. Restringir por dominios y APIs (Maps JavaScript + Routes).
# No colocar aqui una clave privada de servidor. Sin esta variable sigue disponible la navegacion externa.
VITE_GOOGLE_MAPS_API_KEY=
# Opcional: ID de mapa JavaScript para estilos/marcadores avanzados. Sin ID se usa DEMO_MAP_ID para desarrollo.
VITE_GOOGLE_MAPS_MAP_ID=
