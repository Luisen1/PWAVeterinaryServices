# Valores públicos del proyecto Supabase. Opcionales para ejecutar el shell.
# Nunca colocar claves service_role, secretas ni credenciales privadas en VITE_.
VITE_SUPABASE_URL=
# Admite una clave publishable (sb_publishable_) o anon legacy.
VITE_SUPABASE_ANON_KEY=
# Mapas y HU17: clave PUBLICA de navegador. Restringir por dominios y APIs (Maps JavaScript + Routes).
# No colocar aqui una clave privada de servidor. Sin esta variable sigue disponible la navegacion externa.
VITE_GOOGLE_MAPS_API_KEY=
# Opcional: ID de mapa JavaScript para estilos/marcadores avanzados. Sin ID se usa DEMO_MAP_ID para desarrollo.
VITE_GOOGLE_MAPS_MAP_ID=
# Clave publica VAPID P-256 para suscripciones Web Push (HU30).
VITE_WEB_PUSH_PUBLIC_KEY=
# Solo backend de envio. Conservar el par; no publicar ni regenerar al compilar.
WEB_PUSH_PRIVATE_KEY=
# Correo de contacto del operador para el protocolo VAPID, por ejemplo mailto:tu-correo@dominio.com.
WEB_PUSH_SUBJECT=
# Secreto aleatorio de 32 bytes base64url, compartido exclusivamente por Vault y el worker remoto.
NOTIFICATION_WORKER_SECRET=

# Solo backend. Estas variables NO llevan VITE_ ni se publican en el navegador.
# npm run deploy:secrets carga solo esta lista en Supabase desde .env.local.
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los proporciona Edge Runtime.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Activar solo después de configurar y comprobar call-maintenance.
LIVEKIT_MAINTENANCE_READY=false
